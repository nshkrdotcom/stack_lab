{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production_e2e_receipt_v1.json",
  "title": "True Production E2E Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_name",
    "proof_class",
    "production_e2e",
    "path",
    "temporal",
    "host_composition",
    "appkit",
    "mezzanine",
    "citadel",
    "jido_integration",
    "lower_receipt",
    "reducer_projection",
    "extravaganza",
    "evidence"
  ],
  "properties": {
    "schema_name": {
      "const": "production_e2e_receipt_v1.json"
    },
    "forbidden_provider_smoke_schema": {
      "const": "provider_smoke_receipt_v1.json"
    },
    "proof_class": {
      "const": "true_production_e2e"
    },
    "production_e2e": {
      "const": true
    },
    "path": {
      "type": "array",
      "prefixItems": [
        {"const": "extravaganza"},
        {"const": "appkit"},
        {"const": "mezzanine"},
        {"const": "citadel"},
        {"const": "jido_integration"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "temporal": {
      "type": "object",
      "required": ["target", "namespace", "mode", "status"]
    },
    "host_composition": {
      "type": "object",
      "required": ["appkit_backend", "backend_configured?", "bypasses_citadel?"]
    },
    "evidence": {
      "type": "object",
      "required": ["required", "durable_refs", "requirements_met?", "placeholder_artifact_refs?"]
    }
  }
}
